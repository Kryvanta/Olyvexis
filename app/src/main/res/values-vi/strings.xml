    <string name="sheet_shizuku_title">Shizuku</string>
    <string name="sheet_shizuku_desc">Olyvexis cần Shizuku để tạo desktop, mở app thành cửa sổ và điều khiển chuột, bàn phím. Bật bằng Gỡ lỗi không dây ngay trên máy: không cần root, không cần máy tính.</string>

    <!-- Hướng dẫn Shizuku -->
    <string name="shizuku_not_running">Shizuku chưa chạy. Làm theo các bước sau:</string>
    <string name="shizuku_step_1">Cài Shizuku (Google Play hoặc GitHub).</string>
    <string name="shizuku_step_2">Bật Tuỳ chọn nhà phát triển: vào Cài đặt > Giới thiệu về điện thoại, chạm 7 lần vào Số hiệu bản dựng.</string>
    <string name="shizuku_step_3">Kết nối Wi-Fi. Trong Tuỳ chọn nhà phát triển, bật Gỡ lỗi không dây.</string>
    <string name="shizuku_step_4">Mở Shizuku, chọn Ghép nối trong mục Gỡ lỗi không dây. Shizuku hiện một thông báo để nhập mã.</string>
    <string name="shizuku_step_5">Quay lại Gỡ lỗi không dây, chọn \"Ghép nối thiết bị bằng mã ghép nối\", rồi nhập mã 6 số vào thông báo của Shizuku.</string>
    <string name="shizuku_step_6">Trong Shizuku bấm Bắt đầu, rồi quay lại đây.</string>
    <string name="shizuku_reboot_note">Sau mỗi lần khởi động lại máy, cần mở Shizuku và bấm Bắt đầu lại.</string>
    <string name="shizuku_open">Mở Shizuku</string>
    <string name="shizuku_download">Tải Shizuku</string>
    <string name="shizuku_dev_options">Tuỳ chọn nhà phát triển</string>
    <string name="shizuku_recheck">Kiểm tra lại</string>
    <string name="shizuku_outdated">Bản Shizuku trên máy quá cũ (cần API 11+). Cập nhật Shizuku rồi kiểm tra lại.</string>
    <string name="shizuku_update">Tải bản mới</string>
    <string name="shizuku_no_perm">Shizuku đang chạy. Cấp quyền cho Olyvexis.</string>
    <string name="shizuku_grant">Cấp quyền</string>
    <string name="shizuku_denied">Bạn đã từ chối quyền. Mở Shizuku > Ứng dụng được cấp quyền, bật Olyvexis rồi quay lại.</string>
    <string name="shizuku_ready_shell">Đã kết nối Shizuku (shell uid 2000).</string>
    <string name="shizuku_ready_root">Shizuku đang chạy bằng root (uid 0). Nếu gặp lỗi tạo màn hình ảo, hãy khởi động Shizuku qua Gỡ lỗi không dây.</string>
    <string name="shizuku_test_cmd">Chạy thử lệnh</string>
    <string name="shizuku_testing">Đang chạy…</string>

    <!-- Màn hướng dẫn lần đầu -->
    <string name="welcome_p1_title">Nối màn hình</string>
    <string name="welcome_p1_l1">Cắm điện thoại vào màn hình hoặc TV bằng cáp USB-C → HDMI/DisplayPort, nếu máy xuất hình được.</string>
    <string name="welcome_p1_l2">Hoặc bấm Laptop: desktop hiện trong trình duyệt của laptop hay TV cùng Wi-Fi.</string>
    <string name="welcome_p1_l3">Máy có chế độ desktop riêng (Samsung DeX, Honor PC mode…) thì tắt nó đi trước khi cắm cáp.</string>
    <string name="welcome_p1_l4">Desktop hiện trên màn hình lớn; điện thoại thành trackpad và bàn phím.</string>

    <string name="welcome_p2_title">Bật Shizuku</string>
    <string name="welcome_p2_l1">Cài Shizuku, rồi bật Tuỳ chọn nhà phát triển (chạm 7 lần vào Số hiệu bản dựng).</string>
    <string name="welcome_p2_l2">Nối Wi-Fi, bật Gỡ lỗi không dây, rồi ghép nối trong app Shizuku bằng mã 6 số.</string>
    <string name="welcome_p2_l3">Trong Shizuku bấm Bắt đầu, rồi cấp quyền cho Olyvexis.</string>
    <string name="welcome_p2_l4">Sau mỗi lần khởi động lại máy, mở Shizuku và bấm Bắt đầu lại.</string>

    <string name="welcome_p3_title">Điện thoại là trackpad</string>
    <string name="welcome_p3_l1">Di một ngón để di con trỏ, chạm để nhấp, chạm hai ngón hoặc giữ lâu để nhấp phải.</string>
    <string name="welcome_p3_l2">Kéo hai ngón để cuộn.</string>
    <string name="welcome_p3_l3">Xoay ngang điện thoại: trackpad chiếm cả màn hình.</string>

    <string name="welcome_p4_title">Bàn phím và chuột</string>
    <string name="welcome_p4_l1">Dùng laptop: chuột và bàn phím của laptop điều khiển desktop luôn.</string>
    <string name="welcome_p4_l2">Bàn phím, chuột Bluetooth hoặc cắm qua hub dùng được ngay.</string>
    <string name="welcome_p4_l3">Hoặc gõ ở ô dưới cùng trên điện thoại, mọi ngôn ngữ (Telex, VNI…).</string>
    <string name="welcome_p4_l4">Meta mở ngăn ứng dụng, Alt+F4 đóng cửa sổ, Meta+mũi tên để ghép nửa màn hình.</string>

