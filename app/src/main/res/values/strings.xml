    <string name="sheet_shizuku_title">Shizuku</string>
    <string name="sheet_shizuku_desc">Olyvexis uses Shizuku to create the desktop, open apps in windows, and inject mouse/keyboard input. Activate via Wireless Debugging on-device: no root, no PC needed.</string>

    <!-- Shizuku guide -->
    <string name="shizuku_not_running">Shizuku is not running. Follow these steps:</string>
    <string name="shizuku_step_1">Install Shizuku (Google Play or GitHub).</string>
    <string name="shizuku_step_2">Enable Developer Options: Settings > About phone, tap 7 times on Build Number.</string>
    <string name="shizuku_step_3">Connect to Wi-Fi. In Developer Options, enable Wireless Debugging.</string>
    <string name="shizuku_step_4">Open Shizuku, tap Pair under Wireless Debugging. Shizuku shows a notification for the pairing code.</string>
    <string name="shizuku_step_5">Return to Wireless Debugging, tap "Pair device with pairing code", and enter the 6-digit code into Shizuku\'s notification.</string>
    <string name="shizuku_step_6">In Shizuku, tap Start, then return here.</string>
    <string name="shizuku_reboot_note">After each device reboot, open Shizuku and tap Start again.</string>
    <string name="shizuku_open">Open Shizuku</string>
    <string name="shizuku_download">Get Shizuku</string>
    <string name="shizuku_dev_options">Developer Options</string>
    <string name="shizuku_recheck">Check again</string>
    <string name="shizuku_outdated">Installed Shizuku is too old (needs API 11+). Update Shizuku and check again.</string>
    <string name="shizuku_update">Download update</string>
    <string name="shizuku_no_perm">Shizuku is running. Grant permission to Olyvexis.</string>
    <string name="shizuku_grant">Grant permission</string>
    <string name="shizuku_denied">Permission denied. Open Shizuku > Authorized applications, enable Olyvexis, then return.</string>
    <string name="shizuku_ready_shell">Shizuku connected (shell uid 2000).</string>
    <string name="shizuku_ready_root">Shizuku is running as root (uid 0). If virtual display creation fails, start Shizuku via Wireless Debugging instead.</string>
    <string name="shizuku_test_cmd">Run shell test</string>
    <string name="shizuku_testing">Running…</string>

    <!-- Welcome -->
    <string name="welcome_p1_title">Connect a display</string>
    <string name="welcome_p1_l1">Plug your phone into a monitor or TV with a USB-C → HDMI/DisplayPort cable (if supported).</string>
    <string name="welcome_p1_l2">Or tap Laptop: the desktop opens in a laptop or TV browser on the same Wi-Fi.</string>
    <string name="welcome_p1_l3">If your device has its own desktop mode (Samsung DeX, Honor PC mode…), turn it off before plugging in.</string>
    <string name="welcome_p1_l4">The desktop appears on the big screen; your phone becomes the trackpad and keyboard.</string>

    <string name="welcome_p2_title">Start Shizuku</string>
    <string name="welcome_p2_l1">Install Shizuku, then enable Developer Options (tap Build Number 7 times).</string>
    <string name="welcome_p2_l2">Connect Wi-Fi, enable Wireless Debugging, and pair inside Shizuku with the 6-digit code.</string>
    <string name="welcome_p2_l3">Tap Start in Shizuku, then grant permission to Olyvexis.</string>
    <string name="welcome_p2_l4">After each reboot, open Shizuku and tap Start again.</string>

    <string name="welcome_p3_title">Phone as trackpad</string>
    <string name="welcome_p3_l1">Move one finger to move the pointer, tap to click, two-finger tap or long-press to right-click.</string>
    <string name="welcome_p3_l2">Drag with two fingers to scroll.</string>
    <string name="welcome_p3_l3">Rotate the phone sideways for a full-screen trackpad.</string>

    <string name="welcome_p4_title">Keyboard and mouse</string>
    <string name="welcome_p4_l1">In Laptop mode, your laptop\'s mouse and keyboard control the desktop directly.</string>
    <string name="welcome_p4_l2">Bluetooth or USB-hub keyboards and mice work right away.</string>
    <string name="welcome_p4_l3">Or type in the bottom field on your phone in any language (Telex, VNI…).</string>
    <string name="welcome_p4_l4">Meta opens the app drawer, Alt+F4 closes windows, Meta+arrows snap to screen halves.</string>

